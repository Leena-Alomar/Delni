      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Itinerary fetched', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "const firstStop = data.days?.[0]?.blocks?.[0]?.places?.[0];",
              "if (firstStop) {",
              "  pm.collectionVariables.set('tripPlaceId', firstStop.tripPlaceId);",
              "  pm.collectionVariables.set('selectedPlaceId', firstStop.placeId);",
              "}"
            ]
          }
        }
      ]
